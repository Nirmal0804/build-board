{
  "name": "buildboard-monorepo",
  "version": "0.1.0",
  "description": "A community platform for developers to share projects, ask questions, discover opportunities, and learn together.",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server"
  },
  "keywords": [
    "open-source",
    "developer-community",
    "react",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "BuildBoard Contributors",
  "license": "MIT"
}
